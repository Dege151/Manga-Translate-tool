{
    "manifest_version": 3,
    "name": "Manga Translator",
    "version": "1.1",
    "description": "Manga Translator SaaS - Z tuşu ile hızlı çeviri",
    "permissions": [
        "activeTab",
        "scripting",
        "identity",
        "storage"
    ],
    "host_permissions": [
        "http://127.0.0.1:5000/*",
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "oauth2": {
        "client_id": "243801428740-k2dul7o7kmh7guapap32rlj08pglma98.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/userinfo.profile"
        ]
    }
}